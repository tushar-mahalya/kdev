---
import Base from './Base.astro';
import { getCollection } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  headings: MarkdownHeading[];
  id: string;
}
const { title, description, headings, id } = Astro.props;
const all = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const href = (i: string) => (i === 'index' ? '/docs/' : `/docs/${i}/`);
const groups = ['Start', 'Concepts', 'Reference', 'Project'] as const;
const idx = all.findIndex((d) => d.id === id);
const prev = all[idx - 1];
const next = all[idx + 1];
const toc = headings.filter((h) => h.depth === 2);
const current = all[idx];
const origin = new URL('/', Astro.site).href;
const url = new URL(href(id), Astro.site).href;
const mdPath = `/docs/${id}.md`;
const jsonld = [
  {
    '@type': 'TechArticle',
    headline: title,
    description,
    url,
    inLanguage: 'en',
    isPartOf: { '@id': `${origin}#website` },
    about: { '@type': 'SoftwareApplication', name: 'kdev', url: origin },
    encoding: { '@type': 'MediaObject', encodingFormat: 'text/markdown', contentUrl: new URL(mdPath, Astro.site).href },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'kdev', item: origin },
      { '@type': 'ListItem', position: 2, name: 'Docs', item: new URL('/docs/', Astro.site).href },
      ...(id === 'index' ? [] : [{ '@type': 'ListItem', position: 3, name: title, item: url }]),
    ],
  },
];
---

<Base title={title} description={description} type="article" jsonld={jsonld} markdown={mdPath}>
  <div class="docs wrap">
    <aside class="side" aria-label="Docs">
      <details class="side__m" data-side-details>
        <summary><span>{current?.data.group}</span> / {title}</summary>
        <nav class="side__nav">
          {groups.map((g) => (
            <div class="side__g">
              <p class="side__h">{g}</p>
              <ul role="list">
                {all.filter((d) => d.data.group === g).map((d) => (
                  <li><a href={href(d.id)} class:list={['side__a', { 'is-on': d.id === id }]} aria-current={d.id === id ? 'page' : undefined}>{d.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>
      <nav class="side__nav side__desk" aria-label="Docs pages">
        {groups.map((g) => (
          <div class="side__g">
            <p class="side__h">{g}</p>
            <ul role="list">
              {all.filter((d) => d.data.group === g).map((d) => (
                <li><a href={href(d.id)} class:list={['side__a', { 'is-on': d.id === id }]} aria-current={d.id === id ? 'page' : undefined}>{d.data.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="side__g">
          <p class="side__h">More</p>
          <ul role="list">
            <li><a href="/changelog/" class="side__a">Changelog</a></li>
            <li><a href={site.repo} class="side__a" rel="noopener">GitHub ↗</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <article class="art" data-pagefind-body>
      <header class="art__head">
        <p class="eyebrow">{current?.data.group}</p>
        <h1 class="art__h">{title}</h1>
        <p class="art__lede">{description}</p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <footer class="art__foot" data-pagefind-ignore>
        <a class="art__edit link" href={`${site.repo}/edit/main/website/src/content/docs/${id}.md`} rel="noopener">Edit this page on GitHub</a>
        <nav class="pn" aria-label="Previous and next page">
          {prev ? <a class="pn__a" href={href(prev.id)}><span class="dim">Previous</span><b>← {prev.data.title}</b></a> : <span></span>}
          {next && <a class="pn__a pn__a--n" href={href(next.id)}><span class="dim">Next</span><b>{next.data.title} →</b></a>}
        </nav>
      </footer>
    </article>

    <aside class="toc" aria-label="On this page">
      {toc.length > 0 && (
        <>
          <p class="side__h">On this page</p>
          <ul role="list" data-toc>
            {toc.map((h) => <li><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}
          </ul>
        </>
      )}
    </aside>
  </div>
</Base>

<style>
  .docs { display: grid; grid-template-columns: 220px minmax(0, 1fr) 200px; gap: clamp(24px, 4vw, 56px); padding-block: 40px 96px; }
  .side, .toc { position: sticky; top: calc(var(--nav-h) + 24px); align-self: start; max-height: calc(100vh - var(--nav-h) - 48px); overflow-y: auto; }
  .side__h { font-family: var(--font-pixel); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-3); margin: 0 0 8px 12px; }
  .side__g + .side__g { margin-top: 24px; }
  .side ul, .toc ul { list-style: none; margin: 0; padding: 0; }
  .side__a { position: relative; display: flex; align-items: center; min-height: 36px; padding: 0 12px; border-radius: 8px; font-size: 14.5px; color: var(--ink-2); transition: color 0.2s, background 0.2s; }
  .side__a:hover { color: var(--ink); background: var(--accent-soft); }
  .side__a.is-on { color: var(--ink); background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); font-weight: 550; }
  .side__a.is-on::before { content: ''; position: absolute; left: -1px; top: 10px; bottom: 10px; width: 2px; background: var(--accent); border-radius: 2px; view-transition-name: docs-marker; }
  .side__m { display: none; }

  .art { min-width: 0; }
  .art__head { display: grid; gap: 14px; padding-bottom: 28px; margin-bottom: 8px; border-bottom: 1px solid var(--line); }
  .art__h { font-size: clamp(2.2rem, 4.4vw, 3.2rem); letter-spacing: -0.04em; view-transition-name: docs-title; }
  .art__lede { font-size: 1.12rem; color: var(--ink-2); max-width: 60ch; }
  .art__foot { margin-top: 64px; display: grid; gap: 24px; max-width: 72ch; }
  .art__edit { justify-self: start; font-size: 14px; }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .pn__a { display: grid; gap: 4px; padding: 16px 18px; border-radius: 12px; border: 1px solid var(--line); font-size: 14px; transition: border-color 0.25s, transform 0.3s var(--ease); }
  .pn__a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .pn__a b { font-weight: 600; font-size: 15.5px; }
  .pn__a--n { text-align: right; grid-column: 2; }

  .toc ul { border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 6px 0 6px 14px; margin-left: -1px; border-left: 1px solid transparent; font-size: 13.5px; color: var(--ink-3); line-height: 1.4; transition: color 0.2s, border-color 0.2s; }
  .toc a:hover { color: var(--ink); }
  .toc a.is-on { color: var(--accent-ink); border-left-color: var(--accent); }
  .toc .side__h { margin-left: 0; }

  @media (max-width: 1180px) {
    .docs { grid-template-columns: 200px minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 820px) {
    .docs { grid-template-columns: 1fr; padding-top: 16px; }
    .side { position: static; max-height: none; overflow: visible; }
    .side__desk { display: none; }
    .side__m { display: block; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); }
    .side__m summary { min-height: 48px; display: flex; align-items: center; gap: 6px; padding: 0 16px; cursor: pointer; font-size: 14.5px; list-style: none; }
    .side__m summary::-webkit-details-marker { display: none; }
    .side__m summary::after { content: '+'; margin-left: auto; color: var(--ink-3); font-family: var(--font-mono); }
    .side__m[open] summary::after { content: '−'; }
    .side__m summary span { color: var(--ink-3); }
    .side__m .side__nav { padding: 8px 8px 16px; border-top: 1px solid var(--line); }
    .pn { grid-template-columns: 1fr; }
    .pn__a--n { grid-column: 1; }
  }
</style>

<script>
  function setup() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (!links.length) return;
    const targets = links.map((l) => document.getElementById(l.dataset.tocLink!)).filter(Boolean) as HTMLElement[];
    const set = (id: string) => links.forEach((l) => l.classList.toggle('is-on', l.dataset.tocLink === id));
    const io = new IntersectionObserver(
      (entries) => {
        const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (vis[0]) set(vis[0].target.id);
      },
      { rootMargin: '-80px 0px -65% 0px' },
    );
    targets.forEach((t) => io.observe(t));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  }
  document.addEventListener('astro:page-load', setup);
</script>
