  .out__got { font-size: clamp(1.8rem, 3.4vw, 2.5rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1.05; }
  .out__got.t-ok { color: var(--ok); } .out__got.t-live { color: var(--accent-ink); } .out__got.t-warn { color: var(--amber); }
