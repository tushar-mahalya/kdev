<script>
  function setup() {
    const root = document.querySelector<HTMLElement>('[data-ends]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const opts = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const arts = [...root.querySelectorAll<HTMLElement>('[data-art]')];
    const outs = [...root.querySelectorAll<HTMLElement>('[data-out]')];
    const title = root.querySelector<HTMLElement>('[data-win-title]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, seen = false, auto = !reduce, timer = 0;

    const play = () => { root.removeAttribute('data-play'); void root.offsetWidth; root.setAttribute('data-play', ''); };
    const pick = (i: number, focus = false) => {
      cur = i;
      const b = opts[i];
      opts.forEach((o, k) => { o.setAttribute('aria-checked', String(k === i)); o.tabIndex = k === i ? 0 : -1; });
      arts.forEach((a) => a.classList.toggle('on', a.dataset.art === b.dataset.pick));
      outs.forEach((o) => (o.hidden = o.dataset.out !== b.dataset.pick));
      title.textContent = b.dataset.title!;
      if (focus) b.focus();
      if (matchMedia('(max-width: 900px)').matches) b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      if (seen) play();
      schedule();
    };
    // Tour the endings until the reader picks one.
    const schedule = () => { clearTimeout(timer); if (auto && seen) timer = window.setTimeout(() => pick((cur + 1) % opts.length), 6200); };
    const stopTour = () => { auto = false; clearTimeout(timer); root.toggleAttribute('data-manual', true); };
    opts.forEach((o, i) => {
      o.addEventListener('click', () => { stopTour(); pick(i); });
      o.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); stopTour(); pick((i + d + opts.length) % opts.length, true); }
      });
    });
    root.querySelector('[data-replay]')!.addEventListener('click', () => { stopTour(); play(); });
    pick(0);
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !seen) { seen = true; play(); schedule(); }
      else if (!e.isIntersecting) clearTimeout(timer);
      else schedule();
    }, { threshold: 0.35 });
    io.observe(root);
    document.addEventListener('astro:before-swap', () => { clearTimeout(timer); io.disconnect(); }, { once: true });
  }
  document.addEventListener('astro:page-load', setup);
</script>
