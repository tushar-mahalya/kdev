---
// Each ending gets its own artifact, built from kdev's real output and log
// markers (commands/box.py, bootstrap.py), so no two scenarios look alike.
type Tone = 'ok' | 'live' | 'warn';
type Item = { id: string; k: string; got: string; tone: Tone; d: string; title: string };
const groups: { g: string; items: Item[] }[] = [
  {
    g: 'You stop it',
    items: [
      { id: 'down', k: 'kdev down', got: 'Everything', tone: 'ok', title: '~/project — zsh', d: "It stops early and hands the quota back. Kaggle keeps /kaggle/working as that version's output." },
      { id: 'downup', k: 'Down, then straight back up', got: 'Everything', tone: 'ok', title: '~/project — zsh', d: 'kdev up notices the save is still running, waits for it (about 2 minutes per GB), then builds on it.' },
      { id: 'ui', k: 'Stopped from the Kaggle UI', got: 'Everything', tone: 'ok', title: 'notebook session', d: 'A cancel still saves. Measured, not assumed.' },
    ],
  },
  {
    g: 'It ends by itself',
    items: [{ id: 'time', k: 'The time ran out', got: 'Everything', tone: 'ok', title: 'ssh kaggle', d: 'The box stops itself before Kaggle’s deadline, so the save always fits in the session.' }],
  },
  {
    g: 'Something breaks',
    items: [
      { id: 'tunnel', k: 'The tunnel died', got: 'Everything', tone: 'ok', title: 'kdev logs', d: 'The cell notices cloudflared exit, records metadata, and ends the run cleanly, so it saves like any other.' },
      { id: 'crash', k: 'The box crashed', got: 'Everything, up to the crash', tone: 'ok', title: '.kdev/meta.json', d: 'File contents are never lost. Symlinks, empty folders and exec bits are recorded every 30 seconds, so a hard kill costs at most that much metadata.' },
      { id: 'host', k: "Kaggle's machine failed", got: 'Not testable', tone: 'warn', title: 'git log', d: "kdev can't simulate this one. A git-remote is the copy that survives: the box commits and pushes every 15 minutes." },
    ],
  },
  {
    g: 'You walk away',
    items: [{ id: 'wifi', k: 'Laptop closed, Wi-Fi gone', got: 'Nothing ended', tone: 'live', title: 'connection', d: 'The box keeps running on Kaggle. kdev up, from any account or machine, connects to it instead of starting another.' }],
  },
];
const all = groups.flatMap((g) => g.items);
---

<section class="section ends" id="endings" aria-labelledby="ends-h">
  <div class="wrap">
    <header class="section__head">
      <span class="eyebrow">Your files</span>
      <h2 id="ends-h" class="h-section">However it ends,<br /><span class="grad">you start where you were.</span></h2>
      <p class="lede">Kaggle starts every batch session with an empty <code>/kaggle/working</code>. kdev finds the version you left off at, and the new box downloads it before you connect. Eight ways a session ends, each measured.</p>
    </header>

    <div class="player" data-ends>
      <nav class="rail" aria-label="How the last session ended">
        <div role="radiogroup" aria-label="Endings">
          {groups.map((g) => (
            <div class="rail__g">
              <span class="rail__h">{g.g}</span>
              {g.items.map((e) => (
                <button type="button" role="radio" class:list={['opt', `t-${e.tone}`]} data-pick={e.id} data-title={e.title}
                  aria-checked={e.id === 'down' ? 'true' : 'false'} tabindex={e.id === 'down' ? 0 : -1}>
                  <span class="opt__dot" aria-hidden="true"></span>{e.k}
                  <span class="opt__bar" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          ))}
        </div>
      </nav>

      <div class="view">
        <div class="win">
          <div class="win__bar">
            <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="win__t" data-win-title>~/project — zsh</span>
            <button type="button" class="win__replay" data-replay aria-label="Replay this ending">↻</button>
          </div>
          <div class="win__body" aria-hidden="true">

            <!-- kdev down -->
            <div class="art art--term" data-art="down">
              <p class="rv" style="--d:.15s"><span class="p">$</span> kdev down</p>
              <p class="rv ok" style="--d:.9s">✓ stopping; the box saves /kaggle/working as it exits</p>
              <p class="rv mu" style="--d:1.05s">  Next `kdev up` brings it all back, on any account or machine.</p>
              <div class="vers rv" style="--d:1.6s">
                <div class="vers__h"><span>version</span><span>account</span><span>status</span><span>files</span></div>
                <div class="vers__r vers__r--hot"><span>v14</span><span>alice</span><span class="flip"><b class="s1">running</b><b class="s2">saving</b><b class="s3">finished</b></span><span class="count">2429</span></div>
                <div class="vers__r"><span>v13</span><span>bob</span><span><b class="s3 st">finished</b></span><span>2429</span></div>
              </div>
            </div>

            <!-- down, then up -->
            <div class="art art--term" data-art="downup">
              <p class="rv" style="--d:.1s"><span class="p">$</span> kdev down</p>
              <p class="rv ok" style="--d:.5s">✓ stopping; the box saves /kaggle/working as it exits</p>
              <p class="rv" style="--d:1.1s"><span class="p">$</span> kdev up</p>
              <p class="rv" style="--d:1.5s"><span class="spin c"></span> your last box is still saving your files…</p>
              <div class="rv save" style="--d:1.6s"><span class="save__bar"><i></i></span><span class="mu">2.4 GB · about 2 min per GB</span></div>
              <p class="rv ok" style="--d:4.2s">✓ the last box finished saving</p>
              <p class="rv" style="--d:4.6s"><span class="c">›</span> Submitting</p>
            </div>

            <!-- Kaggle UI stop -->
            <div class="art art--ui" data-art="ui">
              <div class="sess">
                <div class="sess__top">
                  <div><b>kdev-box</b><span class="mu"> · session</span></div>
                  <span class="state"><i class="st-run">● Running</i><i class="st-cancel">■ Cancelled</i></span>
                </div>
                <dl class="sess__meta">
                  <div><dt>accelerator</dt><dd>T4 ×2</dd></div>
                  <div><dt>started by</dt><dd>alice</dd></div>
                  <div><dt>running for</dt><dd>3h 12m</dd></div>
                </dl>
                <div class="sess__act"><span class="btn-stop">Stop session</span></div>
                <p class="sess__saved"><span class="ok">✓</span> Output saved as <b>v14</b> · 2429 files</p>
              </div>
              <svg class="cursor" viewBox="0 0 24 24"><path d="M4 2l15 10-7 1.5L9 21z" /></svg>
            </div>

            <!-- time ran out -->
            <div class="art art--time" data-art="time">
              <div class="clock">
                <svg viewBox="0 0 120 120"><circle class="ring-bg" cx="60" cy="60" r="52" /><circle class="ring" cx="60" cy="60" r="52" pathLength="100" /></svg>
                <div class="clock__t"><b class="t1">9:00:00</b><b class="t2">0:15:00</b><b class="t3">0:05:00</b><b class="t4">0:02:00</b><span>left</span></div>
              </div>
              <div class="toasts">
                <p class="rv toast" style="--d:1.2s"><span class="mu">root@kaggle:~#</span> python train.py<br /><span class="warn">kdev: session ends in 15 minutes</span> <em>next release</em></p>
                <p class="rv toast" style="--d:2.2s"><span class="warn">kdev: session ends in 5 minutes</span> <em>next release</em></p>
                <p class="rv toast toast--stop" style="--d:3.2s"><span class="ok">■</span> deadline reached early · saving /kaggle/working</p>
              </div>
            </div>

            <!-- tunnel died -->
            <div class="art art--log" data-art="tunnel">
              <p class="rv mu" style="--d:.1s">KDEV_ALIVE seconds_left=21540</p>
              <p class="rv mu" style="--d:.5s">KDEV_ALIVE seconds_left=21510</p>
              <p class="rv mu" style="--d:.9s">KDEV_ALIVE seconds_left=21480</p>
              <p class="rv err shake" style="--d:1.6s">cloudflared exited; see cloudflared.log</p>
              <p class="rv" style="--d:2.3s">KDEV_DONE</p>
              <p class="rv ok badge" style="--d:3s">✓ v14 finished · /kaggle/working saved</p>
            </div>

            <!-- box crashed -->
            <div class="art art--meta" data-art="crash">
              <div class="track">
                <span class="track__line"></span>
                {[0, 30, 60, 90].map((t, i) => (
                  <span class="tick rv" style={`--x:${t / 120 * 100}%;--d:${0.3 + i * 0.45}s`}><i>✓</i><small>{t}s</small></span>
                ))}
                <span class="gap" style="--x:78%;--w:11%"></span>
                <span class="bolt" style="--x:90%"><svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-2 8 9-12h-7z" /></svg><small>crash · 108s</small></span>
              </div>
              <div class="keep">
                <p class="rv" style="--d:2.6s"><span class="ok">✓</span> File contents <span class="mu">every byte up to the crash</span></p>
                <p class="rv" style="--d:2.9s"><span class="ok">✓</span> Links, empty dirs, exec bits <span class="mu">as of the 90s snapshot</span></p>
                <p class="rv" style="--d:3.2s"><span class="warn">!</span> Metadata from the last 18s <span class="mu">may be missing</span></p>
              </div>
            </div>

            <!-- host failed -->
            <div class="art art--git" data-art="host">
              <p class="rv" style="--d:.1s"><span class="p">$</span> git log --oneline origin/main</p>
              <ul class="graph">
                <li class="rv" style="--d:.5s"><i></i><code class="c">a1f3c2e</code> kdev autosave 2026-11-15 14:45:00 <span class="ref">origin/main</span></li>
                <li class="rv" style="--d:.8s"><i></i><code class="c">9be0d41</code> kdev autosave 2026-11-15 14:30:00</li>
                <li class="rv" style="--d:1.1s"><i></i><code class="c">47cd1a8</code> kdev autosave 2026-11-15 14:15:00</li>
                <li class="rv" style="--d:1.4s"><i></i><code class="c">e02b9f3</code> train: cosine schedule</li>
              </ul>
              <p class="rv err" style="--d:2.2s">✗ 14:52 · the host behind the box failed</p>
              <p class="rv badge badge--warn" style="--d:2.8s">your repo is at most 15 minutes behind</p>
            </div>

            <!-- wifi dropped -->
            <div class="art art--net" data-art="wifi">
              <div class="link">
                <div class="dev dev--lap">
                  <svg viewBox="0 0 24 24" class="wifi"><path d="M2 8.5a15 15 0 0 1 20 0M5 12a10 10 0 0 1 14 0M8.5 15.5a5 5 0 0 1 7 0" /><circle cx="12" cy="19" r="1.2" /><path class="slash" d="M3 3l18 18" /></svg>
                  <b>your laptop</b><span class="mu">offline</span>
                </div>
                <div class="wire"><i></i></div>
                <div class="dev dev--box">
                  <span class="pulse"></span>
                  <b>the box</b><span class="ok">running · ends 23:14</span>
                </div>
              </div>
              <div class="later">
                <p class="rv" style="--d:2s"><span class="p">$</span> kdev up</p>
                <p class="rv ok" style="--d:2.5s">✓ alice/kdev-box is already running</p>
                <p class="rv" style="--d:2.9s"><span class="c">?</span> It is your box. What now? <b>Connect to it</b> <span class="mu">(recommended)</span></p>
                <p class="rv" style="--d:3.4s"><span class="spin c"></span> waiting for ssh…</p>
                <p class="rv ok" style="--d:4s">✓ ready <span class="mu">· ssh kaggle</span></p>
              </div>
            </div>
          </div>
        </div>

        <div class="out" aria-live="polite">
          {all.map((e, i) => (
            <div class="out__card" data-out={e.id} hidden={i !== 0}>
              <p class="out__k">What the next <code>kdev up</code> gives you</p>
              <p class:list={['out__got', `t-${e.tone}`]}>{e.got}</p>
              <p class="out__d">{e.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ends code { font-size: 0.88em; padding: 0.1em 0.35em; border-radius: 5px; background: var(--accent-soft); color: var(--ink); }
  .player { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: start; }

  /* rail */
  .rail { position: sticky; top: calc(var(--nav-h) + 24px); }
  .rail__g { display: grid; gap: 2px; margin-bottom: 14px; }
  .rail__h { font-family: var(--font-pixel); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); padding: 0 12px 6px; }
  .opt { position: relative; display: flex; align-items: center; gap: 12px; width: 100%; min-height: 42px; padding: 0 12px; border-radius: 10px; text-align: left; font-size: 15px; color: var(--ink-2); overflow: hidden; transition: background 0.25s, color 0.25s; }
  .opt:hover { color: var(--ink); background: var(--accent-soft); }
  .opt__dot { width: 7px; height: 7px; border-radius: 2px; background: var(--ok); flex: none; }
  .t-live .opt__dot { background: var(--accent); } .t-warn .opt__dot { background: var(--amber); }
  .opt[aria-checked='true'] { background: var(--panel); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-2); }
  .opt__bar { position: absolute; left: 0; bottom: 0; height: 2px; width: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .player[data-play] .opt[aria-checked='true'] .opt__bar { animation: bar 4.6s linear both; }
  @keyframes bar { to { transform: scaleX(1); } }

  /* window */
  .view { display: grid; gap: 22px; min-width: 0; }
  .win { border-radius: 16px; overflow: hidden; background: var(--term-bg); color: var(--term-ink); border: 1px solid rgb(255 255 255 / 0.08); box-shadow: 0 40px 80px -40px rgb(0 184 212 / 0.25), 0 30px 60px -30px rgb(0 0 0 / 0.6); }
  .win__bar { display: flex; align-items: center; gap: 12px; height: 42px; padding: 0 8px 0 16px; border-bottom: 1px solid rgb(255 255 255 / 0.06); background: rgb(255 255 255 / 0.02); }
  .win__dots { display: flex; gap: 7px; } .win__dots i { width: 11px; height: 11px; border-radius: 50%; background: #3a4048; }
  .win__dots i:nth-child(1) { background: #ff5f57; } .win__dots i:nth-child(2) { background: #febc2e; } .win__dots i:nth-child(3) { background: #28c840; }
  .win__t { flex: 1; text-align: center; font-family: var(--font-mono); font-size: 12px; color: var(--term-dim); }
  .win__replay { width: 40px; height: 34px; border-radius: 8px; color: var(--term-dim); font-size: 16px; transition: color 0.2s, background 0.2s; }
  .win__replay:hover { color: #fff; background: rgb(255 255 255 / 0.06); }
  .win__body { position: relative; height: 340px; font-family: var(--font-mono); font-size: 13.5px; line-height: 1.85; }
  .art { position: absolute; inset: 0; padding: 22px 24px; opacity: 0; visibility: hidden; transition: opacity 0.35s var(--ease), visibility 0s 0.35s; overflow: hidden; }
  .art.on { opacity: 1; visibility: visible; transition: opacity 0.45s var(--ease); }
  .art p { margin: 0; white-space: pre-wrap; }
  .p { color: #00b8d4; } .c { color: #43d5ed; } .mu { color: var(--term-dim); } .ok { color: #3ddc97; } .err { color: #ff6b6b; } .warn { color: #ffb02e; }
  b { color: #fff; font-weight: 600; }
  em { font-style: normal; font-family: var(--font-pixel); font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--term-dim); border: 1px solid rgb(255 255 255 / 0.15); border-radius: 4px; padding: 1px 5px; margin-left: 6px; }

  @media (prefers-reduced-motion: no-preference) {
    .rv { opacity: 0; }
    .player[data-play] .art.on .rv { animation: rv 0.45s var(--ease) both; animation-delay: var(--d, 0s); }
  }
  @keyframes rv { from { opacity: 0; transform: translateY(6px); filter: blur(3px); } to { opacity: 1; transform: none; filter: none; } }
  .spin { display: inline-block; width: 10px; height: 10px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; vertical-align: -1px; animation: rot 0.8s linear infinite; }
  @keyframes rot { to { transform: rotate(360deg); } }

  /* down: versions table */
  .vers { margin-top: 18px; border: 1px solid rgb(255 255 255 / 0.08); border-radius: 10px; overflow: hidden; font-size: 12.5px; }
  .vers__h, .vers__r { display: grid; grid-template-columns: 1fr 1fr 1.4fr 0.8fr; padding: 6px 14px; }
  .vers__h { color: var(--term-dim); background: rgb(255 255 255 / 0.03); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
  .vers__r + .vers__r { border-top: 1px solid rgb(255 255 255 / 0.06); }
  .vers__r--hot { background: rgb(0 184 212 / 0.06); }
  .flip { position: relative; height: 1.85em; }
  .flip b, .st { position: absolute; left: 0; font-size: 11px; padding: 0 7px; border-radius: 5px; line-height: 20px; top: 2px; }
  .st { position: static; display: inline-block; }
  .s1 { background: rgb(0 184 212 / 0.16); color: #43d5ed; }
  .s2 { background: rgb(255 176 46 / 0.16); color: #ffb02e; opacity: 0; }
  .s3 { background: rgb(61 220 151 / 0.16); color: #3ddc97; }
  .flip .s3 { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .player[data-play] [data-art='down'].on .s1 { animation: out 0.3s 2.3s both; }
    .player[data-play] [data-art='down'].on .s2 { animation: inout 1.2s 2.3s both; }
    .player[data-play] [data-art='down'].on .flip .s3 { animation: in 0.4s 3.4s both; }
  }
  @media (prefers-reduced-motion: reduce) { .s1 { opacity: 0; } .flip .s3 { opacity: 1; } }
  @keyframes out { to { opacity: 0; transform: translateY(-6px); } }
  @keyframes in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes inout { 0% { opacity: 0; transform: translateY(6px); } 25%, 75% { opacity: 1; transform: none; } 100% { opacity: 0; transform: translateY(-6px); } }

  /* downup: save bar */
  .save { display: flex; align-items: center; gap: 14px; padding-left: 20px; margin: 4px 0; }
  .save__bar { width: 180px; height: 6px; border-radius: 6px; background: rgb(255 255 255 / 0.08); overflow: hidden; }
  .save__bar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, #ffb02e, #ffd27a); transform-origin: left; }
  @media (prefers-reduced-motion: no-preference) {
    .player[data-play] [data-art='downup'].on .save__bar i { animation: grow 2.4s var(--ease-in-out) 1.7s both; }
  }
  @keyframes grow { from { transform: scaleX(0); } }

  /* ui: session card + cursor */
  .art--ui { display: grid; place-items: center; font-family: var(--font-sans); }
  .sess { width: min(440px, 100%); padding: 18px 20px; border-radius: 14px; background: #10151b; border: 1px solid rgb(255 255 255 / 0.08); }
  .sess__top { display: flex; justify-content: space-between; align-items: center; font-size: 15px; }
  .state { position: relative; font-family: var(--font-mono); font-size: 12px; font-style: normal; }
  .state i { font-style: normal; padding: 3px 9px; border-radius: 6px; }
  .st-run { color: #3ddc97; background: rgb(61 220 151 / 0.12); }
  .st-cancel { position: absolute; right: 0; top: 0; color: #ffb02e; background: rgb(255 176 46 / 0.12); opacity: 0; white-space: nowrap; }
  .sess__meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 16px 0; }
  .sess__meta dt { font-size: 11px; color: var(--term-dim); }
  .sess__meta dd { margin: 0; font-family: var(--font-mono); font-size: 13px; color: #fff; }
  .sess__act { display: flex; justify-content: flex-end; }
  .btn-stop { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 9px; border: 1px solid rgb(255 107 107 / 0.5); color: #ff8a8a; font-size: 14px; }
  .sess__saved { margin-top: 14px; padding-top: 12px; border-top: 1px dashed rgb(255 255 255 / 0.1); font-size: 14px; color: var(--term-ink); opacity: 0; }
  .cursor { position: absolute; width: 22px; height: 22px; fill: #fff; stroke: #000; stroke-width: 1; left: 18%; top: 78%; opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .player[data-play] [data-art='ui'].on .cursor { animation: cur 1.5s var(--ease-in-out) 0.4s both; }
    .player[data-play] [data-art='ui'].on .btn-stop { animation: press 0.25s 1.9s both; }
    .player[data-play] [data-art='ui'].on .st-run { animation: out 0.3s 2.2s both; }
    .player[data-play] [data-art='ui'].on .st-cancel { animation: in 0.35s 2.3s both; }
    .player[data-play] [data-art='ui'].on .sess__saved { animation: rv 0.5s var(--ease) 3s both; }
  }
  @media (prefers-reduced-motion: reduce) { .st-run { opacity: 0; } .st-cancel, .sess__saved { opacity: 1; } }
  @keyframes cur { 0% { opacity: 0; left: 18%; top: 78%; } 20% { opacity: 1; } 100% { opacity: 1; left: calc(50% + 150px); top: calc(50% + 34px); } }
  @keyframes press { 50% { transform: scale(0.94); background: rgb(255 107 107 / 0.18); } }

  /* time: countdown */
  .art--time { display: grid; grid-template-columns: 170px 1fr; gap: 28px; align-items: center; }
  .clock { position: relative; width: 160px; height: 160px; }
  .clock svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .ring-bg { fill: none; stroke: rgb(255 255 255 / 0.08); stroke-width: 6; }
  .ring { fill: none; stroke: #43d5ed; stroke-width: 6; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 98; }
  .clock__t { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; }
  .clock__t b { grid-area: 1 / 1; font-size: 22px; opacity: 0; font-variant-numeric: tabular-nums; }
  .clock__t .t4 { opacity: 1; }
  .clock__t span { font-size: 11px; color: var(--term-dim); }
  .toasts { display: grid; gap: 10px; }
  .toast { padding: 10px 14px; border-radius: 10px; background: rgb(255 255 255 / 0.03); border: 1px solid rgb(255 255 255 / 0.07); font-size: 12.5px; line-height: 1.7; }
  .toast--stop { border-color: rgb(61 220 151 / 0.35); }
  @media (prefers-reduced-motion: no-preference) {
    .player[data-play] [data-art='time'].on .ring { animation: drain 3.4s var(--ease-in-out) 0.2s both; }
    .player[data-play] [data-art='time'].on .t1 { animation: inout 1.2s 0s both; }
    .player[data-play] [data-art='time'].on .t2 { animation: inout 1s 1.1s both; }
    .player[data-play] [data-art='time'].on .t3 { animation: inout 1s 2.1s both; }
    .player[data-play] [data-art='time'].on .t4 { animation: in 0.4s 3.1s both; }
  }
  @keyframes drain { from { stroke-dashoffset: 0; stroke: #43d5ed; } 80% { stroke: #ffb02e; } to { stroke-dashoffset: 98; stroke: #3ddc97; } }

  /* tunnel: log */
  .ts { color: #4d5763; margin-right: 12px; }
  .badge { display: inline-block; margin-top: 14px; padding: 4px 12px; border-radius: 8px; background: rgb(61 220 151 / 0.1); border: 1px solid rgb(61 220 151 / 0.3); }
  .badge--warn { color: #ffb02e; background: rgb(255 176 46 / 0.1); border-color: rgb(255 176 46 / 0.3); }
  @media (prefers-reduced-motion: no-preference) {
    .player[data-play] .art.on .shake { animation: rv 0.45s var(--ease) both, shake 0.36s steps(3) 1.9s 2; }
  }
  @keyframes shake { 33% { transform: translateX(-3px); } 66% { transform: translateX(3px); } }

  /* crash: metadata track */
  .track { position: relative; height: 120px; margin: 10px 8px 6px; }
  .track__line { position: absolute; left: 0; right: 0; top: 46px; height: 2px; background: rgb(255 255 255 / 0.1); }
  .tick { position: absolute; left: var(--x); top: 30px; transform: translateX(-50%); display: grid; justify-items: center; gap: 10px; }
  .tick i { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 9px; background: rgb(61 220 151 / 0.12); color: #3ddc97; font-style: normal; border: 1px solid rgb(61 220 151 / 0.35); }
  .tick small, .bolt small { font-size: 11px; color: var(--term-dim); white-space: nowrap; }
  .gap { position: absolute; left: var(--x); width: var(--w); top: 38px; height: 18px; border-radius: 4px; background: repeating-linear-gradient(135deg, rgb(255 176 46 / 0.25) 0 4px, transparent 4px 8px); opacity: 0; }
  .bolt { position: absolute; left: var(--x); top: 22px; transform: translateX(-50%); display: grid; justify-items: center; gap: 6px; opacity: 0; }
  .bolt svg { width: 40px; height: 40px; fill: #ff6b6b; filter: drop-shadow(0 0 10px rgb(255 107 107 / 0.6)); }
  .keep { display: grid; gap: 4px; }
  @media (prefers-reduced-motion: no-preference) {
    .player[data-play] [data-art='crash'].on .bolt { animation: in 0.3s 2.1s both, shake 0.3s steps(3) 2.4s 2; }
    .player[data-play] [data-art='crash'].on .gap { animation: in 0.4s 2.3s both; }
  }
  @media (prefers-reduced-motion: reduce) { .bolt, .gap { opacity: 1; } }

  /* host: git graph */
  .graph { list-style: none; margin: 10px 0 12px; padding: 0; position: relative; }
  .graph::before { content: ''; position: absolute; left: 6px; top: 12px; bottom: 12px; width: 2px; background: rgb(67 213 237 / 0.35); }
  .graph li { position: relative; padding-left: 26px; font-size: 13px; }
  .graph li i { position: absolute; left: 1px; top: 8px; width: 12px; height: 12px; border-radius: 50%; background: var(--term-bg); border: 2px solid #43d5ed; }
  .graph code { margin-right: 10px; }
  .ref { margin-left: 8px; font-size: 11px; color: #ffb02e; border: 1px solid rgb(255 176 46 / 0.4); border-radius: 5px; padding: 0 6px; }

  /* wifi: connection */
  .link { display: grid; grid-template-columns: 1fr 120px 1fr; align-items: center; gap: 12px; margin: 6px 0 22px; }
  .dev { display: grid; justify-items: center; gap: 4px; padding: 16px; border-radius: 14px; border: 1px solid rgb(255 255 255 / 0.08); background: rgb(255 255 255 / 0.02); font-family: var(--font-sans); font-size: 13.5px; position: relative; }
  .wifi { width: 30px; height: 30px; fill: none; stroke: var(--term-dim); stroke-width: 1.8; stroke-linecap: round; }
  .wifi circle { fill: var(--term-dim); stroke: none; }
  .slash { stroke: #ff6b6b; stroke-dasharray: 26; stroke-dashoffset: 26; }
  .pulse { width: 14px; height: 14px; border-radius: 50%; background: #3ddc97; box-shadow: 0 0 0 0 rgb(61 220 151 / 0.6); animation: ping 1.8s var(--ease) infinite; margin: 8px 0; }
  @keyframes ping { 80%, 100% { box-shadow: 0 0 0 14px transparent; } }
  .wire { height: 2px; background: repeating-linear-gradient(90deg, #43d5ed 0 6px, transparent 6px 11px); position: relative; }
  .later { padding: 12px 16px; border-radius: 10px; background: rgb(255 255 255 / 0.025); border: 1px solid rgb(255 255 255 / 0.06); }
  @media (prefers-reduced-motion: no-preference) {
    .player[data-play] [data-art='wifi'].on .slash { animation: slash 0.5s var(--ease) 0.5s both; }
