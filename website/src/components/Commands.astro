---
import { commands, groups, intents, daily } from '../data/commands';
const COPY = '<svg class="i-copy" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="2"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg><svg class="i-done" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---

<section class="section cmds" id="commands" aria-labelledby="cmds-h">
  <div class="wrap">
    <header class="section__head">
      <span class="eyebrow">Commands</span>
      <h2 id="cmds-h" class="h-section">Four commands a day.<br /><span class="dim">The rest are one question away.</span></h2>
    </header>

    <ol class="loop" role="list" data-loop>
      {daily.map((d, i) => (
        <li class="loop__step" style={`--i:${i}`}>
          <span class="loop__n">{d.n}</span>
          <div class="loop__cmd">
            <code><span class="cmd__p">$</span> {d.cmd}</code>
            <button type="button" class="copy" data-copy={d.cmd} aria-label={`Copy ${d.cmd}`} set:html={COPY} />
          </div>
          <p class="loop__d">{d.d}</p>
        </li>
      ))}
    </ol>

    <div class="finder panel" data-cmds>
      <aside class="finder__side">
        <label class="finder__search">
          <span class="sr-only">Search commands</span>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="9" cy="9" r="5.5"></circle><path d="m13.2 13.2 3.3 3.3" stroke-linecap="round"></path></svg>
          <input type="search" placeholder="Search: restore, port, quota…" data-cmd-filter autocomplete="off" />
        </label>
        <p class="finder__h">I want to…</p>
        <div class="intents" role="radiogroup" aria-label="What do you want to do?">
          <button type="button" role="radio" class="intent" data-intent="" aria-checked="true">See every command</button>
          {intents.map((t) => <button type="button" role="radio" class="intent" data-intent={t.id} aria-checked="false">{t.t}</button>)}
        </div>
      </aside>

      <div class="finder__main">
        {groups.map((g) => (
          <section class="grp" data-grp={g.id} aria-labelledby={`grp-${g.id}`}>
            <header class="grp__h"><h3 id={`grp-${g.id}`}>{g.t}</h3><span>{g.d}</span></header>
            <ul class="cards" role="list">
              {commands.filter((c) => c.group === g.id).map((c) => (
                <li class="card" data-intents={c.intents.join(' ')} data-text={`${c.cmd} ${c.what} ${(c.flags ?? []).join(' ')} ${c.ex}`.toLowerCase()}>
                  <div class="card__top">
                    <code class="card__cmd">{c.cmd}</code>
                    {c.next && <span class="card__next">next release</span>}
                  </div>
                  <p class="card__what">{c.what}</p>
                  {c.flags && <p class="card__flags">{c.flags.map((f) => <span>{f}</span>)}</p>}
                  <div class="card__ex">
                    <code><span class="cmd__p">$</span> {c.ex}</code>
                    <button type="button" class="copy" data-copy={c.ex} aria-label={`Copy ${c.ex}`} set:html={COPY} />
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
        <p class="finder__empty" data-cmd-empty hidden>Nothing matches. Try <em>files</em>, <em>port</em> or <em>account</em>, or read the <a class="link" href="/docs/commands/">full reference</a>.</p>
        <p class="finder__foot">Exit codes: <code>0</code> ok · <code>1</code> failed, with the command that fixes it · <code>2</code> usage · <code>130</code> cancelled. Add <code>-v</code> to any command to log each Kaggle API call. <a class="link" href="/docs/commands/">Full reference →</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .cmds code { font-family: var(--font-mono); }
  .loop { list-style: none; margin: 0 0 20px; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; position: relative; }
  .loop::before { content: ''; position: absolute; left: 6%; right: 6%; top: 50px; height: 2px; z-index: 0; background: repeating-linear-gradient(90deg, var(--line-2) 0 6px, transparent 6px 12px); }
  .loop::after { content: ''; position: absolute; left: 6%; top: 47px; width: 8px; height: 8px; border-radius: 2px; z-index: 0; background: var(--accent); box-shadow: 0 0 12px var(--accent-glow); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .loop[data-run]::after { animation: travel 5.5s var(--ease-in-out) infinite; }
  }
  @keyframes travel { 0% { left: 6%; opacity: 0; } 8% { opacity: 1; } 92% { opacity: 1; } 100% { left: 94%; opacity: 0; } }
  .loop__step { position: relative; z-index: 1; display: grid; gap: 10px; align-content: start; padding: 16px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--panel); transition: border-color 0.25s, transform 0.3s var(--ease); }
  .loop__step:hover { border-color: var(--accent); transform: translateY(-2px); }
  .loop__n { font-family: var(--font-pixel); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-ink); }
  .loop__cmd { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 6px 6px 6px 12px; border-radius: 10px; background: var(--term-bg); }
  .loop__cmd code { font-size: 15px; color: #fff; white-space: nowrap; }
  .loop__cmd .cmd__p, .card__ex .cmd__p { color: #00b8d4; }
  .loop__cmd .copy { color: #8b97a3; width: 36px; height: 36px; }
  .loop__d { font-size: 14px; color: var(--ink-2); line-height: 1.5; }

  .finder { display: grid; grid-template-columns: 280px minmax(0, 1fr); overflow: hidden; }
  .finder__side { padding: 20px; border-right: 1px solid var(--line); background: var(--bg-2); display: grid; align-content: start; gap: 14px; }
  .finder__search { display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 12px; border-radius: 11px; border: 1px solid var(--line-2); background: var(--panel); transition: border-color 0.2s; }
  .finder__search:focus-within { border-color: var(--accent); }
  .finder__search svg { width: 16px; height: 16px; color: var(--ink-3); flex: none; }
  .finder__search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: var(--ink); font: inherit; font-size: 15px; }
  .finder__h { font-family: var(--font-pixel); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-top: 6px; }
  .intents { display: grid; gap: 2px; }
  .intent { position: relative; text-align: left; min-height: 38px; padding: 0 12px; border-radius: 9px; font-size: 14.5px; color: var(--ink-2); transition: background 0.2s, color 0.2s; }
  .intent:hover { color: var(--ink); background: var(--accent-soft); }
  .intent[aria-checked='true'] { background: var(--panel); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line-2); font-weight: 550; }
  .intent[aria-checked='true']::before { content: ''; position: absolute; left: -1px; top: 10px; bottom: 10px; width: 2px; border-radius: 2px; background: var(--accent); }

  .finder__main { padding: 22px; display: grid; gap: 26px; align-content: start; min-height: 560px; }
  @media (min-width: 901px) {
    .finder { height: min(780px, 86vh); }
    .finder__main { overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; mask-image: linear-gradient(to bottom, #000 calc(100% - 40px), transparent); padding-bottom: 48px; }
  }
  .grp[hidden] { display: none; }
  .grp__h { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; margin-bottom: 12px; }
  .grp__h h3 { font-size: 1.05rem; letter-spacing: -0.015em; }
  .grp__h span { font-size: 13.5px; color: var(--ink-3); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .card { display: grid; gap: 8px; align-content: start; padding: 14px 14px 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--panel-2); transition: border-color 0.25s, transform 0.3s var(--ease), box-shadow 0.3s; }
  .card:hover { border-color: var(--line-2); transform: translateY(-2px); box-shadow: 0 14px 30px -20px var(--accent-glow); }
  .card[hidden] { display: none; }
  .card__top { display: flex; align-items: center; gap: 10px; }
  .card__cmd { font-size: 15px; font-weight: 600; color: var(--ink); }
  .card__next { font-family: var(--font-pixel); font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 6px; border-radius: 4px; border: 1px solid var(--line-2); color: var(--ink-3); }
  .card__what { font-size: 14px; color: var(--ink-2); line-height: 1.5; }
  .card__flags { display: flex; flex-wrap: wrap; gap: 5px; }
  .card__flags span { font-family: var(--font-mono); font-size: 11.5px; padding: 2px 7px; border-radius: 5px; background: var(--accent-soft); color: var(--accent-ink); }
  .card__ex { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 2px; padding: 4px 4px 4px 10px; border-radius: 8px; background: var(--term-bg); }
  .card__ex code { font-size: 12.5px; color: var(--term-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .card__ex .copy { width: 32px; height: 32px; color: #8b97a3; flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    .card.flash { animation: flash 0.45s var(--ease) both; animation-delay: calc(var(--k, 0) * 30ms); }
  }
  @keyframes flash { from { opacity: 0; transform: translateY(6px); } }
  .finder__empty, .finder__foot { font-size: 14px; color: var(--ink-2); }
  .finder__foot code { font-size: 12.5px; padding: 1px 5px; border-radius: 5px; background: var(--accent-soft); color: var(--ink); }

  @media (max-width: 1080px) {
    .loop { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .loop::before, .loop::after { display: none; }
  }
  @media (max-width: 900px) {
    .finder { grid-template-columns: minmax(0, 1fr); }
    .finder__main, .grp, .cards { min-width: 0; }
    .finder__side { border-right: 0; border-bottom: 1px solid var(--line); min-width: 0; }
    .intents { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin: 0 -20px; padding: 0 20px 2px; }
    .intent { white-space: nowrap; border: 1px solid var(--line); flex: none; min-height: 40px; }
    .intent[aria-checked='true']::before { display: none; }
    .intent[aria-checked='true'] { border-color: var(--accent); background: var(--accent-soft); box-shadow: none; }
    .finder__main { min-height: 0; padding: 18px 16px; }
  }
  @media (max-width: 640px) {
    .loop { grid-template-columns: 1fr; }
    .cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  function setup() {
    const root = document.querySelector<HTMLElement>('[data-cmds]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';
    const intents = [...root.querySelectorAll<HTMLButtonElement>('[data-intent]')];
    const cards = [...root.querySelectorAll<HTMLElement>('.card')];
    const grps = [...root.querySelectorAll<HTMLElement>('[data-grp]')];
    const input = root.querySelector<HTMLInputElement>('[data-cmd-filter]')!;
    const empty = root.querySelector<HTMLElement>('[data-cmd-empty]')!;
    let intent = '';
    const apply = () => {
      const words = input.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let k = 0;
      cards.forEach((c) => {
        const show = (!intent || c.dataset.intents!.split(' ').includes(intent)) && words.every((w) => c.dataset.text!.includes(w));
        if (show) { c.classList.remove('flash'); void c.offsetWidth; c.style.setProperty('--k', String(k++)); c.classList.add('flash'); }
        c.hidden = !show;
      });
      grps.forEach((g) => (g.hidden = !g.querySelector('.card:not([hidden])')));
      empty.hidden = k > 0;
    };
    intents.forEach((b) => b.addEventListener('click', () => {
      intent = b.dataset.intent!;
      intents.forEach((x) => x.setAttribute('aria-checked', String(x === b)));
      apply();
    }));
    input.addEventListener('input', apply);
    const loop = document.querySelector<HTMLElement>('[data-loop]');
    if (loop) {
      const io = new IntersectionObserver(([e]) => loop.toggleAttribute('data-run', e.isIntersecting));
      io.observe(loop);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    }
  }
  document.addEventListener('astro:page-load', setup);
</script>
